  "sensors": [
    "tank1_level",
    "tank1_temp",
    "tank2_level",
    "tank2_temp",
    "tank3_level",
    "tank3_temp",
    "tank1_flow",
    "tank2_flow",
    "tank3_flow",
    "di_dryfire",
    "di_overflow",
    "di_heater_contactor",
    "di_pump_contactor",
    "di_estop"
  ],
  "actuators": [
    "v_12_cmd",
    "v_23_cmd",
    "e_101_cmd",
    "v_33_cmd",
    "vfd_cmd"
  ],
  "reset": {
    "command_register": "reset_cmd",
    "init_levels": [
      "init_h1",
      "init_h2",
      "init_h3"
    ],
    "init_level_range_m": [
      0.1,
      0.4
    ],
    "mechanism": "reset_cmd lives on slave 03 (holding). Env writes a fresh nonzero nonce to reset_cmd (any value change triggers); cabinet snaps levels to init_h* and HOLDS while reset_cmd != 0; writing 0 resumes stepping. physics_loop must union regvals across all slaves to see reset_cmd."
  },
  "process": {
    "topology": "tank1 --V-12--> tank2 --V-23--> tank3 --V-33--> reservoir --P-101(VFD)--> tank1; heater E-101 (2kW) in tank1 only. Reservoir modeled as infinite (constant level, constant temp = supply).",
    "q_max_m3s": 0.00111,
    "h_max_m": 0.475,
    "t_supply_c": 25.0,
    "a_tank_m2": 0.0784,
    "vfd_max_hz": 50.0,
    "c_v12": 0.000833,
    "c_v23": 0.000833,
    "c_v33": 0.000833,
    "cp_j_per_kgk": 4180.0,
    "rho_kg_per_m3": 1000.0,
    "q_heat_max_w": 2000.0,
    "ua_w_per_k": 4.0,
    "t_ambient_c": 25.0,
    "_placeholders": [
      "c_v12",
      "c_v23",
      "c_v33",
      "ua_w_per_k"
    ],
    "_placeholder_note": "Physics values not yet measured. a_tank_m2 (tank diameter), q_max_m3s (pump curve), c_v* (valve Cv), ua_w_per_k (heat loss) must be refined from the mechanical drawings + pump/valve datasheets + bench SAT. q_heat_max_w=2000 is the real 2kW heater; h_max_m=0.5 from the level sensor span.",
    "_drift_warning": "mock_cabinet.py, controllers/threetank_model.py, and controllers/nmpc_oracle.py hand-mirror these ODEs; all three must change together.",
    "_valve_note": "c_v* scaled 5.6x with the real pump flow (4 m^3/h) to keep the sim balanced; refine with valve datasheet Cv.",
    "reservoir_base_m2": 0.3,
    "reservoir_height_m": 0.5
  },
  "control": {
    "setpoints_m": {
      "tank1_level": 0.3,
      "tank2_level": 0.3,
      "tank3_level": 0.3
    },
    "setpoints_c": {
      "tank1_temp": 45.0,
      "tank2_temp": 45.0,
      "tank3_temp": 45.0
    },
    "objective": "Heated serial cascade, under-actuated. CVs: 3 levels + 3 temps. MVs: pump/VFD->tank1 level, V-12->tank2 level, V-23->tank3 level, E-101 heater->tank1 temp. Only Tank1 temp is directly actuated; Tank2/Tank3 temp rise via downstream hot-water advection (slow, laggy). PID holds 3 levels + Tank1 temp; MPC/RL attempt all 3 temps by coordinating valve flows to propagate heat downstream.",
    "reward": "-(w_level*sum((level_i-sp)^2) + w_temp*sum((temp_i-Tsp)^2) + w_action*sum(action)) per step (maximize). Flow sensors are observation-only (not in reward).",
    "reward_weights": {
      "level": 1.0,
      "temp": 0.0004,
      "action": 0.01,
      "_note": "temp downweighted: Tank2/Tank3 temp are structurally unreachable by PID and laggy under MPC/RL."
    },
    "modes": {
      "manual": 0,
      "pid": 1,
      "mpc": 2,
      "rl": 3
    },
    "mode_vars": {
      "manual": [
        "manual_vfd",
        "manual_v12",
        "manual_v23",
        "manual_h1"
      ],
      "pid": [
        "tank1_level_sp",
        "tank2_level_sp",
        "tank3_level_sp",
        "tank1_temp_sp"
      ],
      "mpc_rl": [
        "v_12_cmd_req",
        "v_23_cmd_req",
        "e_101_cmd_req",
        "v_33_cmd_req",
        "vfd_cmd_req"
      ]
    }
  },
  "timing": {
    "modbus_poll_ms": 50,
    "plc_scan_ms": 50,
    "snapshot_broadcast_hz": 10,
    "obs_lag_ms_est": 250,
    "min_control_dt_s": 0.3,
    "note": "Observation lag is higher than the legacy single-slave plant: multi-slave reads (AI 02/05, DI 04) are separate round-trips on top of the 50 ms Modbus poll + 50 ms PLC scan + 10 Hz snapshot. Keep control_dt >= 0.3 s."
  }
}