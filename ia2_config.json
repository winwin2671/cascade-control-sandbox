  "test_actuators": [
    "sv_1_cmd",
    "sv_2_cmd",
    "sv_3_cmd"
  ],
  "_test_actuators_note": "On/off interlock-test solenoids SV-1..3 (DO slave 07), each parallel to its modulating valve. Operator/test-harness writes ONLY (env.set_test_valve / set_test_valves_enabled) — deliberately excluded from `actuators` so the RL action space, trained policies, and benchmark KPIs are unaffected while all SVs stay closed.",
  "reset": {
    "command_register": "reset_cmd",
    "init_levels": [
      "init_h1",
      "init_h2",
      "init_h3"
    ],
    "init_level_range_m": [
      0.1,
      0.4
    ],
    "mechanism": "reset_cmd lives on slave 03 (holding). Env writes a fresh nonzero nonce to reset_cmd (any value change triggers); cabinet snaps levels to init_h* and HOLDS while reset_cmd != 0; writing 0 resumes stepping. physics_loop must union regvals across all slaves to see reset_cmd."
  },
  "process": {
    "topology": "tank1 --V-12--> tank2 --V-23--> tank3 --V-33--> reservoir --P-101(VFD)--> tank1; heater E-101 (2kW) in tank1 only. On/off interlock-test solenoids SV-1/SV-2/SV-3 sit parallel to V-12/V-23/V-33 (test instrumentation, normally closed — see test_actuators). Reservoir is finite (0.3 m2 x 0.5 m, ~150 L max), internal/uninstrumented; the pump draws at T_res and overflow returns to it.",
    "q_max_m3s": 0.00111,
    "h_max_m": 0.475,
    "t_supply_c": 25.0,
    "a_tank_m2": 0.0784,
    "vfd_max_hz": 50.0,
    "c_v12": 0.00143,
    "c_v23": 0.00143,
    "c_v33": 0.00143,
    "c_sv": 0.00143,
    "cp_j_per_kgk": 4180.0,
    "rho_kg_per_m3": 1000.0,
    "q_heat_max_w": 2000.0,
    "ua_w_per_k": 4.0,
    "t_ambient_c": 25.0,
    "_placeholders": [
      "c_v12",
      "c_v23",
      "c_v33",
      "c_sv",
      "ua_w_per_k"
    ],
    "_placeholder_note": "c_v* (valve Cv), c_sv (on/off solenoid Cv — full-port, same line size as the modulating valves) and ua_w_per_k (heat loss) are physics-derived estimates pending bench SAT measurement. The hard numbers are set from the BOM + datasheets: a_tank_m2=0.0784 (300x300mm tank, 10mm walls), q_max_m3s=0.00111 (4 m^3/h pump), pump curve static_head=1.7m / shutoff_head=10.0m / power=370W, q_heat_max_w=2000 (real 2kW heater), h_max_m=0.475 (tank fill height).",
    "_drift_warning": "The ODEs live in ONE place: controllers/threetank_dynamics.py (dynamics + compute_flows). mock_cabinet.py, controllers/threetank_model.py, and controllers/nmpc_oracle.py all import from it \u2014 edit there and all three follow.",
    "_valve_note": "c_v* scaled 5.6x with the real pump flow (4 m^3/h) to keep the sim balanced; refine with valve datasheet Cv.",
    "reservoir_base_m2": 0.3,
    "reservoir_height_m": 0.5,
    "high_level_trip_m": 0.45,
    "low_level_trip_m": 0.05,
    "temperature_trip_c": 70.0,
    "gravity_drop_m": 0.3,
    "pump_power_max_w": 370.0,
    "nominal_level_m": 0.3,
    "overflow_level_m": 0.46,
    "cv_overflow": 0.001,
    "overflow_head_floor": 1e-09,
    "pump_static_head_m": 1.7,
    "pump_shutoff_head_m": 10.0
  },
  "control": {
    "setpoints_m": {
      "tank1_level": 0.3,
      "tank2_level": 0.3,
      "tank3_level": 0.3
    },
    "setpoints_c": {
      "tank1_temp": 45.0,
      "tank2_temp": 45.0,
      "tank3_temp": 45.0
    },
    "objective": "Heated serial cascade, under-actuated. CVs: 3 levels + 3 temps. MVs: pump/VFD->tank1 level, V-12->tank2 level, V-23->tank3 level, E-101 heater->tank1 temp. Only Tank1 temp is directly actuated; Tank2/Tank3 temp rise via downstream hot-water advection (slow, laggy). PID holds 3 levels + Tank1 temp; MPC/RL attempt all 3 temps by coordinating valve flows to propagate heat downstream.",
    "reward": "-(w_level*sum((level_i-sp)^2) + w_temp*sum((temp_i-Tsp)^2) + w_action*sum(action)) per step (maximize). Flow sensors are observation-only (not in reward).",
    "reward_weights": {
      "level": 1.0,
      "temp": 0.0004,
      "action": 0.01,
      "_note": "temp downweighted: Tank2/Tank3 temp are structurally unreachable by PID and laggy under MPC/RL."
    },
    "modes": {
      "manual": 0,
      "pid": 1,
      "mpc": 2,
      "rl": 3
    },
    "mode_vars": {
      "manual": [
        "manual_vfd",
        "manual_v12",
        "manual_v23",
        "manual_h1"
      ],
      "pid": [
        "tank1_level_sp",
        "tank2_level_sp",
        "tank3_level_sp",
        "tank1_temp_sp"
      ],
      "mpc_rl": [
        "v_12_cmd_req",
        "v_23_cmd_req",
        "e_101_cmd_req",
        "v_33_cmd_req",
        "vfd_cmd_req"
      ]
    }
  },
