{
  "$schema": "cascade-control-sandbox/ia2_config/v2",
  "project": "cascade_control_sandbox",
  "description": "Register <-> engineering-variable map for the HEATED SERIAL-CASCADE + recirculation plant. Single contract shared by mock_cabinet.py (encoder), the IA2 Modbus iomap (ia2_project/, via tools/gen_ia2_artifacts.py), and aio_bridge_env.py (decoder). Topology: tank1 --V-12--> tank2 --V-23--> tank3 --V-33--> reservoir --P-101(VFD)--> tank1; one 2kW heater (E-101) in tank1. Multi-slave via an RTU-to-TCP gateway; analog values are 32-bit floats (2 regs, big-endian ABCD); safety statuses are FC02 discretes; on/off interlock-test solenoids SV-1..3 are FC05 coils on the DO module (slave 07).",
  "modbus": {
    "transport": "tcp",
    "gateway": "127.0.0.1:5020",
    "host": "127.0.0.1",
    "port": 5020,
    "default_slave_id": 1,
    "timeout_s": 2.0,
    "byte_order": "big",
    "word_order": "big"
  },
  "ia2": {
    "server_url": "http://127.0.0.1:3001",
    "health_path": "/api/health",
    "project_name": "cascade_control_sandbox",
    "application_pou": "ThreeTank"
  },
  "slaves": {
    "ai": {
      "slave_id": 2,
      "role": "AI module 1 (FC04 input registers, float)"
    },
    "ao": {
      "slave_id": 3,
      "role": "AO module + reset (FC06/FC16 holding, float/uint16)"
    },
    "di": {
      "slave_id": 4,
      "role": "DI module (FC02 discrete inputs, bool)"
    },
    "ai2": {
      "slave_id": 5,
      "role": "AI module 2 (FC04 input registers, float) \u2014 TT-301"
    },
    "vfd": {
      "slave_id": 6,
      "role": "Inovance MD200 VFD (holding) \u2014 pump P-101 speed"
    },
    "do": {
      "slave_id": 7,
      "role": "DO relay module (FC05 coils, bool) \u2014 SV-1..3 on/off interlock-test solenoids"
    }
  },
